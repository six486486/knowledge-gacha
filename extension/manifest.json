{
  "manifest_version": 3,
  "name": "知识扭蛋机",
  "version": "1.0.1",
  "key": "",
  "description": "把文章、笔记和截图变成一张能理解、能复习的知识卡。",
  "minimum_chrome_version": "114",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'" },
  "icons": {
    "16": "assets/extension-icons/icon-16.png",
    "32": "assets/extension-icons/icon-32.png",
    "48": "assets/extension-icons/icon-48.png",
    "128": "assets/extension-icons/icon-128.png"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "tabs"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": { "service_worker": "src/backend/background.js" },
  "action": {
    "default_title": "打开知识扭蛋机",
    "default_icon": {
      "16": "assets/extension-icons/icon-16.png",
      "32": "assets/extension-icons/icon-32.png"
    }
  },
  "side_panel": { "default_path": "index.html" }
}
