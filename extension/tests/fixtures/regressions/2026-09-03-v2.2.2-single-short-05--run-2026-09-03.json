          "exercise": {
            "type": "choice",
            "question": "以下哪个函数定义会导致默认列表参数跨调用保留内容？",
            "options": [
              "def f(x, lst=[]): lst.append(x); return lst",
              "def f(x, lst=None): lst = [] if lst is None else lst; lst.append(x); return lst",
              "def f(x, lst=()): lst = list(lst); lst.append(x); return lst"
            ],
            "correctIndex": 0,
